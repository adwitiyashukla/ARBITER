# Copy this file to .env and fill in one key. .env is gitignored.
#
# Google AI Studio gives a free API key with no card:
#   https://aistudio.google.com/apikey
# Free tier models at the time of writing: gemini-3.6-flash, gemini-3.5-flash,
# gemini-3.5-flash-lite.
GEMINI_API_KEY=

# Optional alternatives.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
